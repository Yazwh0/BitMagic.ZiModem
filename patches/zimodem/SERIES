# Ordered list of patches applied to the vendored copy of external/zimodem by
# tools/vendor.py. One filename per line, applied top to bottom via `git apply`.
# Blank lines and lines starting with # are ignored.
#
# Rules for what belongs here: mechanical portability changes only (new platform
# branch selection, swapping an ESP-only #include for our compat header of the
# same name). Never a behavior change. See docs/native-wrapper-spec.md section 6.3.

# Adds a ZIMODEM_HOST_BUILD platform branch to the same #if/#elif ladder that
# already distinguishes ESP32 from ESP8266, so host builds get their own
# SerialConfig/debugPrintf/pin definitions instead of silently falling into the
# ESP8266 branch. Also disables SSH/SD-shell/SLIP/PPP for this build phase via
# the same INCLUDE_* undef mechanism upstream already uses per-platform.
0001-add-zimodem-host-platform-branch.patch

# pet2asc.h has its own separate #ifdef ZIMODEM_ESP32/#else ladder (not the one patch
# 0001 touches in zimodem.ino) whose #else branch assumes ESP8266 and does
# `#include "ESP8266WiFi.h"` -- unavailable and inappropriate on a host build. Adds a
# ZIMODEM_HOST branch that aliases HWSerial to our own virtual-UART global instead,
# mirroring the existing `#define HWSerial Serial` idiom the ESP8266 branch already uses.
0002-pet2asc-host-serial-alias.patch

# MSVC has no variable-length-array support (a GCC/arduino-esp32-toolchain extension the
# vendored code relies on in a handful of places) and VLAs aren't standard C++ on any
# compiler, so they're a genuine cross-platform portability gap, not something a HAL
# header can paper over. Each site becomes a std::vector-backed heap buffer, with the
# raw pointer kept under the original variable name so every downstream use of it (array
# indexing, strcpy/memcpy, passing to functions expecting a pointer) is untouched --
# purely a storage-location change, not a behavior change. 0005 additionally const_casts
# one `char *end = strrchr(remotepath, '/')` in proto_ftp.ino's fixPath: remotepath is a
# `const char*` parameter but the function later writes through `end` (`*end = 0;`) --
# GCC accepts the implicit const-stripping conversion there, MSVC correctly rejects it as
# an error. The const_cast makes the existing (already latent) mutation-through-a-const-
# parameter behavior compile under stricter conformance, without changing what it does.
0003-zcommand-no-vla.patch
0004-pet2asc-ino-no-vla.patch
0005-proto_ftp-no-vla.patch
0006-zstream-no-vla.patch
0007-proto_http-no-vla.patch
0008-zircmode-no-vla.patch

# ZMode declares serialIncoming()/loop() as plain virtual with no definition anywhere
# (not even in the class body) -- every concrete mode (ZStream, ZCommand, ZPrint, ...)
# overrides both, and nothing anywhere calls ZMode:: directly, so this is a base class
# meant to be pure-interface. GCC's linker tolerates the missing base vtable slot;
# MSVC's doesn't (LNK2001 unresolved external symbol). Marking them `= 0` is the
# idiomatic, minimal fix -- ZMode was never instantiated directly, so this changes
# nothing observable, just makes the "must override" intent explicit enough for a
# stricter linker.
0009-zmode-pure-virtual.patch

# Uncomments the upstream `//#define INCLUDE_CMDRX16 true` line so the Commander X16
# I/O card configuration block (the `#ifdef INCLUDE_CMDRX16` ladder further down
# zimodem.ino) is compiled in for the host build. Upstream ships it commented out
# because it is board-specific ("enable this if you are David or Kevin"); for this
# project the X16 I/O card is the target, so it is always on. Pure configuration
# toggle of an existing upstream option, no code change.
0010-zimodem-enable-cmdrx16.patch

# Routes the ZIMODEM_HOST build into the same createWiFiClient() code path the ESP32
# build uses when a secure connection is requested (FLAG_SECURE / https:// URLs), by
# widening two `#ifdef ZIMODEM_ESP32` guards in wificlientnode.h to
# `#if defined(ZIMODEM_ESP32) || defined(ZIMODEM_HOST)`. Same shape as patch 0002
# (adds a host arm to an existing upstream ladder, reuses the existing ESP32 body
# verbatim). Backed by a real HAL WiFiClientSecure (native/hal, mbedTLS); without this
# patch the host build silently returns a plaintext WiFiClient for secure dials, the
# ESP8266 fallback behaviour.
0011-wificlient-host-tls.patch

# showInitMessage()'s banner is a two-way `#ifdef ZIMODEM_ESP32` / `#else` split that
# can only print "ESP32" or "ESP8266"; the host build is ZIMODEM_HOST (neither) and
# falls through to "ESP8266", which is misleading. Adds a ZIMODEM_HOST arm printing
# "ZiModem BitMagic " so the running firmware identifies itself unambiguously. Cosmetic
# (diagnostic string only); the ESP32/ESP8266 arms are unchanged in behaviour.
0012-banner-bitmagic.patch

# Every one of the 39 files under zimodem/src/libssh2/ (the vendored libssh2 client
# library backing WiFiSSHClient/INCLUDE_SSH) is wrapped top-to-bottom in a single
# `#if defined(ESP32) ... #endif`, so none of it compiles on any non-ESP32 target today.
# Widens each file's opening guard to `#if defined(ESP32) || defined(ZIMODEM_HOST)` --
# same idiom as 0002/0011 widening an existing upstream ESP32-only branch for the host
# build -- so libssh2 compiles here too. Deliberately NOT done via a blanket `#define
# ESP32`: zimodem.ino's own board-detection ladder treats bare `#elif defined(ESP32)` as
# a trigger for ZIMODEM_ESP32, which would incorrectly also enable real hardware-setup
# code elsewhere. Mechanical, one-line-per-file change; nothing inside these files is
# otherwise touched.
0013-libssh2-host-guards.patch

# libssh2_config.h (widened by 0013 above) unconditionally #defines 8 POSIX-only feature
# macros (HAVE_UNISTD_H, HAVE_SYS_SOCKET_H, HAVE_STRCASECMP, etc.) inside its ESP32/host
# guard. Upstream libssh2.h/libssh2_priv.h (untouched, not ESP32-specific) already have
# complete, correct native Windows support gated on `_MSC_VER`/`WIN32` -- these 8 macros
# just need to stop being falsely defined on Windows so that support activates. Excluding
# HAVE_STRCASECMP on _WIN32 also activates an existing dead fallback in this same file
# (`#define strcasecmp _stricmp`) for free. Linux/ESP32 behaviour is unchanged (macros
# stay defined there).
0014-libssh2-config-windows.patch

# Removes the `# undef INCLUDE_SSH` line from patch 0001's own ZIMODEM_HOST_BUILD branch
# in zimodem.ino, re-enabling libssh2/WiFiSSHClient support for the host build now that
# 0013/0014 make it actually compile. A dedicated patch, not an edit to 0001 itself --
# same precedent as 0010 re-enabling INCLUDE_CMDRX16 -- so this one flag is independently
# revertable. INCLUDE_HOSTCM/COMET64/CBMMODEM/SLIP/PPP/PING/OTH_UPDATES stay undef'd.
0015-zimodem-enable-ssh.patch

# wifisshclient.ino has three real portability bugs (not ESP32-vs-host feature gaps):
# closeSSH()'s close(sock) is POSIX-only (needs closesocket() on Windows);
# connect(IPAddress,uint16_t)'s success path falls off the end with no return statement
# (GCC/ESP32 tolerates it, MSVC will not); and it calls the arduino-esp32-only static
# WiFiGenericClass::hostByName(), which the host WiFi.h shim doesn't have (only the
# instance method WiFi.hostByName(), already used correctly elsewhere e.g. rt_clock.ino).
# All three found by reading the function bodies in full, not guessed.
0016-wifisshclient-host-portability.patch

# libssh2.h's own WIN32 branch includes <winsock2.h> for SOCKET etc. but not
# <ws2tcpip.h>, which is where this SDK's socklen_t typedef (used by
# session.c's getsockopt()-based non-blocking-check fallback) actually lives. A missing
# standard-header include, not an ESP32-vs-host gap -- found by attempting the build, same
# as the HAVE_IOCTLSOCKET addition in 0014.
0017-libssh2-socklen-windows.patch
